//  AppSecrets.swift
//  AirRaid
//
//  Copy to AirRaid/App/Configuration/AppSecrets.swift (git-ignored) and fill in.
//

/// Local, uncommitted configuration read by `AppEnvironment`.
nonisolated enum AppSecrets {

    #if targetEnvironment(simulator)
    /// The developer key for `POST /v1/dev/token` (`DEV_KEY` on the server). Compiled into simulator builds only;
    /// leave empty to use a limited unattested token instead.
    static let devKey = ""
    #endif
}
