//
//  AppSecrets.swift
//  AirRaid
//
//  Copy to AirRaid/App/Configuration/AppSecrets.swift (git-ignored) and fill in.
//

/// Local, uncommitted configuration read by `AppEnvironment`.
nonisolated enum AppSecrets {

    /// The «Небо» API server, e.g. the current tunnel address `https://<name>.trycloudflare.com`.
    static let apiServerURLString = ""

    /// The app key (`APP_KEYS` in the server's `.env`).
    static let apiKey = ""
}
